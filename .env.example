# Copy to .env and edit. docker-compose reads this automatically.
# Everything here is optional — without it you can still sign in via
# http://localhost:8787/dev/login?email=teacher@example.com&role=teacher

# Set to false once real Google sign-in works, to close the local shortcut.
DEV_LOGIN=true

# Any long random string. `openssl rand -base64 32` is ideal.
SESSION_SECRET=change-me

# From the Google Cloud console. Add http://localhost:8787/auth/callback
# as an authorised redirect URI on the same OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The Google address that becomes the first teacher on its first sign-in.
BOOTSTRAP_TEACHER_EMAIL=teacher@example.com
